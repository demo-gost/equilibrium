# Environment — Root .env for docker-compose
# Copy to .env and fill in your values

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/equilibrium?retryWrites=true&w=majority

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_me
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_change_me
