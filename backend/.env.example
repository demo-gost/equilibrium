# Environment Variables — Backend
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Option A: Local MongoDB (Docker or locally installed)
MONGODB_URI=mongodb://localhost:27017/equilibrium

# Option B: MongoDB Atlas (cloud — replace with your connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/equilibrium?retryWrites=true&w=majority

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ML Service (local dev)
ML_SERVICE_URL=http://localhost:8000

# CORS — Frontend URL
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
